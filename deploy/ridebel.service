[Unit]
Description=RideBEL Django application
After=network.target

[Service]
User=ridebel
Group=www-data
WorkingDirectory=/srv/ridebel
EnvironmentFile=/srv/ridebel/.env
ExecStart=/srv/ridebel/.venv/bin/gunicorn --config deploy/gunicorn.conf.py ridebel.wsgi:application
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ridebel

[Install]
WantedBy=multi-user.target
