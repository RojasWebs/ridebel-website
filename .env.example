# Copy to .env, keep private (chmod 600), and supply real values there.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ridebel.com,www.ridebel.com
DJANGO_TRUST_PROXY=false
# A durable SQLite path; default is db.sqlite3 in the project folder.
# DJANGO_DB_PATH=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=
